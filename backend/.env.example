# Copy to backend/.env and fill in. backend/.env is git-ignored; never put real keys in this file.

# Pinecone API key from https://app.pinecone.io -> API Keys.
PINECONE_API_KEY=
# The index is created on first ingest. The free Starter plan only offers aws/us-east-1.
RAG_PINECONE_INDEX=rag-system
RAG_PINECONE_NAMESPACE=documents
# Index each table row on its own too (small-to-big retrieval); applies at ingest.
RAG_INDEX_TABLE_ROWS=true

# AWS credentials come from this named CLI profile (~/.aws/config), never from this file.
RAG_AWS_PROFILE=contextforge
RAG_AWS_REGION=ap-southeast-2

# Embeddings: "pinecone" (Pinecone Inference, same API key) or "bedrock" (Titan V2).
# Vectors from different models cannot be mixed: changing provider or model needs a re-ingest,
# and changing dimensions needs a new index.
RAG_EMBEDDING_PROVIDER=pinecone
RAG_PINECONE_EMBEDDING_MODEL=llama-text-embed-v2
RAG_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
RAG_EMBEDDING_DIMENSIONS=1024

# Retrieval pipeline: basic (dense), hybrid (dense + sparse with RRF), advanced (hybrid + rerank),
# basic-rerank. Hybrid needs the sparse index, which every ingest writes.
RAG_RETRIEVAL_PIPELINE=advanced
RAG_PINECONE_SPARSE_INDEX=rag-system-sparse
RAG_PINECONE_SPARSE_MODEL=pinecone-sparse-english-v0
RAG_RETRIEVAL_CANDIDATES=20
RAG_RRF_K=1
RAG_HYBRID_SPARSE_WEIGHT=0.5
RAG_RERANK_MODEL=bge-reranker-v2-m3

# Who writes answers: "gemini" (Google AI Studio key, free tier: Flash models) or "bedrock".
RAG_ANSWER_PROVIDER=gemini
RAG_GEMINI_API_KEY=
RAG_GEMINI_MODEL_IDS=["gemini-3.5-flash","gemini-3.5-flash-lite"]

# Bedrock answer models as a JSON list, tried in order when one is throttled or unavailable.
RAG_ANSWER_MODEL_IDS=["qwen.qwen3-235b-a22b-2507-v1:0","global.amazon.nova-2-lite-v1:0"]

# OCR scanned pages with AWS Textract (needs textract:DetectDocumentText; see config/iam/).
RAG_OCR_ENABLED=true

# Retrieval tuning.
RAG_CHUNK_SIZE_CHARS=1800
RAG_CHUNK_OVERLAP_CHARS=300
RAG_DEFAULT_TOP_K=6
